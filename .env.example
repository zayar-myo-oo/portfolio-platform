# ── Database ────────────────────────────────────────────────────────────────
# Local dev: `npm run db:start` (embedded Postgres) or `docker compose up -d`.
DATABASE_URL="postgresql://portfolio:portfolio@localhost:54329/portfolio"

# ── Site ────────────────────────────────────────────────────────────────────
# Absolute origin used for canonical URLs, sitemap, Open Graph and JSON-LD.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Admin bootstrap (used by `npm run db:seed` and `npm run admin:create`) ──
# The seed creates/updates this admin account. Use a long, unique password.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-to-a-long-random-password"

# ── Media storage ───────────────────────────────────────────────────────────
# Uploaded files are stored here (outside /public) and served via /media/*.
UPLOAD_DIR=".data/uploads"
